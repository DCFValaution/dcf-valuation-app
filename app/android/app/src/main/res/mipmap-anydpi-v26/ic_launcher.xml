<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon for Android 8.0+. The launcher masks these two layers to
  whatever shape the device uses (circle, squircle, rounded square), which is
  why the foreground mark is drawn small enough to survive any crop.
  Pre-8.0 devices fall back to the flat mipmap PNGs.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
