<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9 (API 28) and later block plaintext HTTP by default. The dev
  backend is served over plain HTTP on the host machine, so it has to be
  allowed explicitly or every request fails with a CLEARTEXT_NOT_PERMITTED
  error that looks like a connection failure.

  This permits cleartext ONLY for the loopback addresses used in development:

    10.0.2.2  - how the Android emulator reaches the host machine's localhost
    127.0.0.1 / localhost - a device or emulator reaching itself, e.g. via
                            `adb reverse tcp:8000 tcp:8000`

  Everything else still requires HTTPS, so this does not weaken the app for
  real traffic. When the backend moves to a real host, it should be HTTPS and
  this file can be deleted.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
